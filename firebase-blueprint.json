{
  "entities": {
    "DeviceOrder": {
      "title": "DeviceOrder",
      "description": "Represents an iCloud bypass or checking order for a device",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "imei": { "type": "string" },
        "ecid": { "type": "string" },
        "iosVersion": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["checked", "pending_review", "waiting_payment", "verifying_payment", "processing", "ready_activation", "completed"]
        },
        "adminFeedback": { "type": "string" },
        "feedbackDate": { "type": "string" },
        "price": { "type": "string" },
        "successRate": { "type": "string" },
        "transactionId": { "type": "string" },
        "paymentStatus": {
          "type": "string",
          "enum": ["none", "pending", "approved", "rejected"]
        },
        "processingProgress": { "type": "integer" },
        "processingStage": { "type": "string" },
        "firmwareRequestStatus": { "type": "string" },
        "firmwareLink": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "imei", "ecid", "iosVersion", "status", "paymentStatus", "processingProgress", "firmwareRequestStatus", "createdAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Represents a user or system notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "icon": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "time": { "type": "string" },
        "read": { "type": "boolean" },
        "type": {
          "type": "string",
          "enum": ["server", "order", "payment", "firmware", "maintenance", "promotion"]
        }
      },
      "required": ["id", "icon", "title", "description", "time", "read", "type"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "A history log of operations performed in the dashboard",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "user": { "type": "string" },
        "time": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["info", "success", "warning", "error"]
        }
      },
      "required": ["id", "action", "details", "user", "time", "type"]
    },
    "PaymentHistoryItem": {
      "title": "PaymentHistoryItem",
      "description": "Represents payment transactions submitted by the customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "imei": { "type": "string" },
        "ecid": { "type": "string" },
        "amount": { "type": "string" },
        "transactionId": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "date": { "type": "string" },
        "customer": { "type": "string" }
      },
      "required": ["id", "orderId", "imei", "ecid", "amount", "transactionId", "status", "date", "customer"]
    },
    "DeviceCheck": {
      "title": "DeviceCheck",
      "description": "Represents a Device Check Request submitted by customer for admin review",
      "type": "object",
      "properties": {
        "requestId": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "imeiSerial": { "type": "string" },
        "ecid": { "type": "string" },
        "iosVersion": { "type": "string" },
        "submittedAt": { "type": "string" },
        "currentStatus": {
          "type": "string",
          "enum": ["Waiting", "Reviewing", "Feedback Sent", "Expired"]
        },
        "adminFeedback": { "type": "string" },
        "reviewedBy": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "device": { "type": "string" },
        "supportStatus": { "type": "string" },
        "successRate": { "type": "string" },
        "registrationRequired": { "type": "string" }
      },
      "required": ["requestId", "userId", "username", "email", "imeiSerial", "ecid", "iosVersion", "submittedAt", "currentStatus"]
    },
    "DepositRequest": {
      "title": "DepositRequest",
      "description": "Represents a USDT wallet deposit request submitted by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "transactionId": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "email", "transactionId", "status", "createdAt"]
    },
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Global settings like Server Status",
      "type": "object",
      "properties": {
        "serverStatus": {
          "type": "string",
          "enum": ["online", "offline"]
        }
      },
      "required": ["serverStatus"]
    },
    "SupportChat": {
      "title": "SupportChat",
      "description": "Customer support session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "username": { "type": "string" },
        "topic": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["open", "resolved"]
        },
        "lastMessage": { "type": "string" },
        "lastActivity": { "type": "string" },
        "unreadByAdmin": { "type": "boolean" },
        "unreadByUser": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "email", "username", "topic", "status", "lastActivity", "unreadByAdmin", "unreadByUser", "createdAt"]
    },
    "SupportChatMessage": {
      "title": "SupportChatMessage",
      "description": "A single message in a support chat subcollection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender": {
          "type": "string",
          "enum": ["user", "admin"]
        },
        "content": { "type": "string" },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "sender", "content", "createdAt", "read"]
    },
    "UserSession": {
      "title": "UserSession",
      "description": "Represents an active or recent user session in the activity monitor",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "country": { "type": "string" },
        "ipAddress": { "type": "string" },
        "deviceBrowser": { "type": "string" },
        "lastActive": { "type": "string" },
        "currentPage": { "type": "string" },
        "isOnline": { "type": "boolean" },
        "lastAction": { "type": "string" }
      },
      "required": ["uid", "userId", "username", "email", "lastActive", "currentPage"]
    },
    "UserActivity": {
      "title": "UserActivity",
      "description": "Represents an individual user activity event log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "action": { "type": "string" },
        "page": { "type": "string" },
        "timestamp": { "type": "string" },
        "ipAddress": { "type": "string" },
        "country": { "type": "string" },
        "details": { "type": "string" },
        "deviceBrowser": { "type": "string" }
      },
      "required": ["userId", "username", "email", "action", "page", "timestamp"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "DeviceOrder",
      "description": "The collection of orders placed by customers"
    },
    "/notifications/{notificationId}": {
      "schema": "NotificationItem",
      "description": "Global or user notifications"
    },
    "/logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Activity logs shown in the admin panel"
    },
    "/payments/{paymentId}": {
      "schema": "PaymentHistoryItem",
      "description": "Payment verification transactions"
    },
    "/deviceChecks/{checkId}": {
      "schema": "DeviceCheck",
      "description": "The collection of device checks submitted by customers"
    },
    "/deposits/{depositId}": {
      "schema": "DepositRequest",
      "description": "USDT deposit requests submitted by customers"
    },
    "/site_configs/{configId}": {
      "schema": "SiteConfig",
      "description": "Global system configurations"
    },
    "/support_chats/{chatId}": {
      "schema": "SupportChat",
      "description": "Live support chat tickets"
    },
    "/support_chats/{chatId}/messages/{messageId}": {
      "schema": "SupportChatMessage",
      "description": "Message logs inside a support chat session"
    },
    "/user_sessions/{sessionId}": {
      "schema": "UserSession",
      "description": "Active user sessions tracked by the activity monitor"
    },
    "/user_activities/{activityId}": {
      "schema": "UserActivity",
      "description": "Feed of user activity events across the app"
    }
  }
}
