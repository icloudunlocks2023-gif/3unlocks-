rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Rule 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers (Phase 3)
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == "iunlockapple1427@gmail.com" || request.auth.token.email == "iunlockapple01@gmail.com");
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity validation helpers (Pillar 2: Anti-Update-Gap)
    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.imei is string && data.imei.size() <= 128 &&
             data.ecid is string && data.ecid.size() <= 128 &&
             data.iosVersion is string && data.iosVersion.size() <= 32 &&
             data.status in ['checked', 'pending_review', 'waiting_payment', 'verifying_payment', 'processing', 'ready_activation', 'completed'] &&
             data.paymentStatus in ['none', 'pending', 'approved', 'rejected'] &&
             (data.processingProgress is number || data.processingProgress is int) &&
             data.firmwareRequestStatus in ['none', 'requested', 'sent'] &&
             data.createdAt is string &&
             (!('adminFeedback' in data) || data.adminFeedback is string) &&
             (!('feedbackDate' in data) || data.feedbackDate is string) &&
             (!('price' in data) || data.price is string || data.price is number) &&
             (!('successRate' in data) || data.successRate is string) &&
             (!('transactionId' in data) || data.transactionId is string) &&
             (!('processingStage' in data) || data.processingStage is string) &&
             (!('firmwareLink' in data) || data.firmwareLink is string) &&
             (!('userId' in data) || data.userId is string) &&
             (!('email' in data) || data.email is string);
    }

    function isValidNotification(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.icon is string && data.icon.size() <= 64 &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 1000 &&
             data.time is string &&
             data.read is bool &&
             data.type is string &&
             (!('userId' in data) || data.userId is string) &&
             (!('targetUserId' in data) || data.targetUserId is string) &&
             (!('targetEmail' in data) || data.targetEmail is string) &&
             (!('link' in data) || data.link is string) &&
             (!('url' in data) || data.url is string);
    }

    function isValidDeviceCheck(data) {
      return data.requestId is string && data.requestId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.username is string && data.username.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.imeiSerial is string && data.imeiSerial.size() <= 128 &&
             data.ecid is string && data.ecid.size() <= 128 &&
             data.iosVersion is string && data.iosVersion.size() <= 32 &&
             data.submittedAt is string &&
             data.currentStatus is string;
    }

    function isValidDeposit(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.transactionId is string && data.transactionId.size() <= 128 &&
             (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected') &&
             data.createdAt is string;
    }

    function isValidSiteConfig(data) {
      return (data.serverStatus == 'online' || data.serverStatus == 'offline' || data.serverStatus == 'Online' || data.serverStatus == 'Offline') &&
             (!('trafficLevel' in data) || data.trafficLevel in ['low', 'medium', 'high']);
    }

    function isValidSupportChat(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.username is string && data.username.size() <= 128 &&
             data.topic is string && data.topic.size() <= 200 &&
             (data.status == 'open' || data.status == 'resolved') &&
             (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 1000)) &&
             data.lastActivity is string &&
             data.unreadByAdmin is bool &&
             data.unreadByUser is bool &&
             data.createdAt is string;
    }

    function isValidSupportChatMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             (data.sender == 'user' || data.sender == 'admin') &&
             data.content is string && data.content.size() <= 2000 &&
             data.createdAt is string &&
             data.read is bool;
    }

    function isValidUserSession(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.username is string && data.username.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             (!('country' in data) || data.country is string) &&
             (!('ipAddress' in data) || data.ipAddress is string) &&
             (!('deviceBrowser' in data) || data.deviceBrowser is string) &&
             data.lastActive is string &&
             data.currentPage is string &&
             (!('isOnline' in data) || data.isOnline is bool) &&
             (!('lastAction' in data) || data.lastAction is string);
    }

    function isValidUserActivity(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.username is string && data.username.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.action is string && data.action.size() <= 500 &&
             data.page is string && data.page.size() <= 200 &&
             data.timestamp is string &&
             (!('uid' in data) || data.uid is string) &&
             (!('status' in data) || data.status is string) &&
             (!('country' in data) || data.country is string) &&
             (!('ipAddress' in data) || data.ipAddress is string) &&
             (!('details' in data) || data.details is string) &&
             (!('deviceBrowser' in data) || data.deviceBrowser is string);
    }

    // Rules for each collection
    match /orders/{orderId} {
      allow get, list: if isVerified() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isVerified() && isValidId(orderId) && isValidOrder(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isVerified() && isValidOrder(incoming()) && (
        isAdmin() || 
        (incoming().userId == request.auth.uid && incoming().userId == existing().userId)
      );
      allow delete: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow read, list, delete: if true;
      allow create, update: if isVerified() && isValidNotification(incoming());
    }

    match /logs/{logId} {
      allow read, list: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read, list: if isVerified() && (isAdmin() || resource.data.customer == request.auth.token.email);
      allow create, update: if isVerified();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, list: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /deposits/{depositId} {
      allow get, list: if isVerified() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isVerified() && isValidId(depositId) && isValidDeposit(incoming()) && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /deviceChecks/{checkId} {
      allow get, list: if isVerified() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isVerified() && isValidId(checkId) && isValidDeviceCheck(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isVerified() && isValidDeviceCheck(incoming()) && (
        isAdmin() || 
        (incoming().userId == request.auth.uid && incoming().userId == existing().userId)
      );
      allow delete: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banned_users/{email} {
      allow read, write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_configs/{configId} {
      allow read: if true;
      allow write: if isAdmin() && isValidSiteConfig(incoming());
    }

    match /support_chats/{chatId} {
      allow get: if isVerified() && (isAdmin() || chatId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isVerified() && chatId == request.auth.uid && isValidId(chatId) && isValidSupportChat(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isVerified() && (
        isAdmin() ||
        (chatId == request.auth.uid && isValidSupportChat(incoming()) && incoming().userId == request.auth.uid)
      );
      allow delete: if isAdmin() || (isVerified() && chatId == request.auth.uid);

      match /messages/{messageId} {
        allow get: if isVerified() && (isAdmin() || chatId == request.auth.uid);
        allow list: if isVerified() && (isAdmin() || chatId == request.auth.uid);
        allow create: if isVerified() && (isAdmin() || chatId == request.auth.uid) && isValidId(messageId) && isValidSupportChatMessage(incoming());
        allow update: if isAdmin();
        allow delete: if isAdmin() || (isVerified() && chatId == request.auth.uid);
      }
    }

    match /user_sessions/{sessionId} {
      allow get: if isVerified() && (isAdmin() || sessionId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isVerified() && sessionId == request.auth.uid && isValidUserSession(incoming());
      allow update: if isVerified() && (
        isAdmin() ||
        (sessionId == request.auth.uid && isValidUserSession(incoming()))
      );
      allow delete: if isAdmin() || (isVerified() && sessionId == request.auth.uid);
    }

    match /user_activities/{activityId} {
      allow read, list: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
